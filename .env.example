# ─────────────────────────────────────────────────────────────
# AquaFlow Car Wash Management System
# Environment Configuration Example
# Powered by Quantum Axis
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────

DJANGO_SECRET_KEY=your-secret-key-here-minimum-50-characters
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Database ─────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=aquaflow
DB_USER=aquaflow_user
DB_PASSWORD=your-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

# ─── Application ──────────────────────────────────────────────
APP_VERSION=1.0.0
TIMEZONE=Asia/Colombo
LANGUAGE_CODE=en-us

# ─── Currency ─────────────────────────────────────────────────
DEFAULT_CURRENCY_CODE=LKR
DEFAULT_CURRENCY_SYMBOL=Rs.
DEFAULT_CURRENCY_NAME=Sri Lankan Rupee

# ─── Backup ───────────────────────────────────────────────────
BACKUP_PATH=C:\AquaFlow\backups

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Email ────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend