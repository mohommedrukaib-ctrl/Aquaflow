DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.100,.ngrok-free.app,.ngrok.io
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok.io,http://127.0.0.1:8000,http://localhost:8000

# ─── Database ─────────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=aquaflow_db
DB_USER=postgres
DB_PASSWORD=Rukaib@2006
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

# ─── Application ──────────────────────────────────────────────
APP_VERSION=1.0.0
TIMEZONE=Asia/Colombo
LANGUAGE_CODE=en-us

# ─── Currency (LKR Default) ───────────────────────────────────
DEFAULT_CURRENCY_CODE=LKR
DEFAULT_CURRENCY_SYMBOL=Rs.
DEFAULT_CURRENCY_NAME=Sri Lankan Rupee

# ─── Backup ───────────────────────────────────────────────────
BACKUP_PATH=C:\backups

# ─── Redis (optional - comment out if not installed) ──────────
REDIS_URL=redis://127.0.0.1:6379/0?protocol=2

# ─── Email ────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend